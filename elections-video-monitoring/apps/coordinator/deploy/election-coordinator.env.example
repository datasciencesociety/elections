# Copy to /etc/election-coordinator.env on the server (chmod 600, owned by root).
PORT=3000
# nginx terminates TLS; keep the plain-HTTP port local
HOST=127.0.0.1
# Existing database; deploy aborts if it is missing (ALLOW_NEW_DB=1 to start empty)
DB_PATH=/var/lib/election-coordinator/streams.db
# openssl rand -hex 32 — changing it logs everyone out
COOKIE_SECRET=
COOKIE_SECURE=1
# HLS proxy in nginx-site.conf (same origin); empty = cards play evideo directly, without detection
PROXY_URL=https://video.promeni.bg/hls
# Only read when the users table is empty
# ADMIN_USER=
# ADMIN_PASS=
