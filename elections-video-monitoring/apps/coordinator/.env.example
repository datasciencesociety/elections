# Port the coordinator listens on
PORT=3000

# Seed admin account (required on first startup with empty DB, ignored after)
ADMIN_USER=admin
ADMIN_PASS=changeme123

# Secret for signing login cookies. Set it so logins survive restarts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Login lifetime in ms (default 24 h)
# COOKIE_TTL_MS=86400000

# Set to 1 only when served over HTTPS (adds the Secure cookie flag)
# COOKIE_SECURE=1

# SQLite database path
# DB_PATH=data/streams.db

# URL of the CORS proxy app (required — start apps/proxy first)
PROXY_URL=http://127.0.0.1:8788
